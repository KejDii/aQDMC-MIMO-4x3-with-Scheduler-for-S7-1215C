FUNCTION "MatrixFilled" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      lb_1 : DInt;
      ub_1 : DInt;
      lb_2 : DInt;
      ub_2 : DInt;
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[*, *] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	
	
	FOR #i := #lb_1 TO #ub_1 DO
	    FOR #j := #lb_2 TO #ub_2 DO
	        #C[#i, #j] := #val;
	    END_FOR;
	END_FOR;
	
	
	
END_FUNCTION

DATA_BLOCK "Scheduler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      tm_break : Bool;
      flag_global : DInt;
      flag_iter : DInt;
      time_start {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_bound : UDInt;
      time_check {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_duration : UDInt;
   END_VAR


BEGIN

END_DATA_BLOCK

DATA_BLOCK "QDMCconfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      H : Int;
      L : Int;
      nV : Int;
      kappa : Real;
      prog_szumu : Real;
      gamma : Real;
      ro : Array[1..4, 1..1] of Real;
      QDMC_init : Bool;
      czy_pobudzenie : Bool;
      U_max : Array[1..4, 1..1] of Real;
      U_min : Array[1..4, 1..1] of Real;
      dU_max : Array[1..4, 1..1] of Real;
      dU_min : Array[1..4, 1..1] of Real;
      Y_max : Array[1..3, 1..1] of Real;
      Y_min : Array[1..3, 1..1] of Real;
      solver_max_iter : Int;
   END_VAR


BEGIN
   H := 20;
   L := 1;
   nV := 20;
   kappa := 1.0;
   prog_szumu := 0.5;
   gamma := 0.01;
   ro[1,1] := 20000.0;
   ro[2,1] := 15000.0;
   ro[3,1] := 15000.0;
   ro[4,1] := 15000.0;
   U_max[1,1] := 0.1;
   U_max[2,1] := 0.6;
   U_max[3,1] := 0.75;
   U_max[4,1] := 0.8;
   U_min[1,1] := 0.0;
   U_min[2,1] := 0.0;
   U_min[3,1] := 0.0;
   U_min[4,1] := 0.0;
   dU_max[1,1] := 0.04;
   dU_max[2,1] := 0.1;
   dU_max[3,1] := 0.1;
   dU_max[4,1] := 0.1;
   dU_min[1,1] := -0.04;
   dU_min[2,1] := -0.1;
   dU_min[3,1] := -0.1;
   dU_min[4,1] := -0.1;
   Y_max[1,1] := 30.0;
   Y_max[2,1] := 30.0;
   Y_max[3,1] := 30.0;
   Y_min[1,1] := 0.0;
   Y_min[2,1] := 0.0;
   Y_min[3,1] := 0.0;
   solver_max_iter := 20;

END_DATA_BLOCK

FUNCTION "MatrixIdentity" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      lb : DInt;
      ub : DInt;
   END_VAR

   VAR_OUTPUT 
      C : Array[*, *] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
   END_VAR


BEGIN
	
	
	"MatrixFilled"(lb_1 := #lb,
	               ub_1 := #ub,
	               lb_2 := #lb,
	               ub_2 := #ub,
	               val := 0.0,
	               C => #C);
	FOR #i := #lb TO #ub DO
	    #C[#i, #i] := 1;
	END_FOR;
	
	
	
END_FUNCTION

DATA_BLOCK "QDMCInOut"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      u_in : Array[1..4, 1..1] of Real;
      y_obiekt : Array[1..3, 1..1] of Real;
      y_zad : Array[1..3, 1..1] of Real;
      u_out : Array[1..4, 1..1] of Real;
      y_model : Array[1..3, 1..1] of Real;
   END_VAR


BEGIN
   y_zad[1,1] := 10.0;
   y_zad[2,1] := 10.0;
   y_zad[3,1] := 10.0;

END_DATA_BLOCK

FUNCTION "MatrixTranspose" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[*, *] of Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[*, *] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
      lb_1 : DInt;
      lb_2 : DInt;
      ub_1 : DInt;
      ub_2 : DInt;
      status : Int;
   END_VAR


BEGIN
	
	//if rhere is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    
	    //if there is no break - compute normally
	    IF NOT "Scheduler".tm_break THEN
	        
	        #lb_1 := LOWER_BOUND(ARR := #A, DIM := 1);
	        #lb_2 := LOWER_BOUND(ARR := #A, DIM := 2);
	        #ub_1 := UPPER_BOUND(ARR := #A, DIM := 1);
	        #ub_2 := UPPER_BOUND(ARR := #A, DIM := 2);
	        FOR #i := #lb_2 TO #ub_2 DO
	            FOR #j := #lb_1 TO #ub_1 DO
	                #C[#i, #j] := #A[#j, #i];
	            END_FOR;
	        END_FOR;
	    END_IF;
	END_IF;
	//iterate global flag
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
	
	
END_FUNCTION

